#!/opt/bin/sh
# smartdns-redirect init script for Entware.
# Real script lives in package dir; symlink in /opt/etc/init.d/ enables boot.
# S39 = runs AFTER S38smartdns (upstream DNS must be ready first).
# shellcheck disable=SC3043  # 'local' supported by ash/busybox sh
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/smartdns-redirect"
SCRIPTS="$INSTALL_DIR/scripts"
_CONFIG_DIR="$INSTALL_DIR/config"
. /opt/keenetic-entware-extras/lib/common.sh
. "$_CONFIG_DIR/defaults.conf"
[ -f "$_CONFIG_DIR/config.conf" ] && . "$_CONFIG_DIR/config.conf"

case "${1:-}" in
  start)
    rm -f "$PIDFILE"
    echo "Starting smartdns-redirect..."
    "$SCRIPTS/dns-redirect.sh" start
    update_pid_file "$PIDFILE"
    ;;
  stop)
    echo "Stopping smartdns-redirect..."
    "$SCRIPTS/dns-redirect.sh" stop
    rm -f "$PIDFILE"
    ;;
  reload)
    echo "Reloading smartdns-redirect..."
    "$SCRIPTS/dns-redirect.sh" reload
    update_pid_file "$PIDFILE"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    "$SCRIPTS/status.sh"
    ;;
  enable)
    ln -sf "$INSTALL_DIR/init.d/$(basename "$0")" "/opt/etc/init.d/$(basename "$0")"
    "$0" start
    ;;
  disable)
    "$0" stop
    rm -f "/opt/etc/init.d/$(basename "$0")"
    echo "smartdns-redirect disabled (persistent until 'enable')"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|status|enable|disable}"
    exit 1
    ;;
esac
