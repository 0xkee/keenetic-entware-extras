#!/opt/bin/sh
# S37smartdns-conf — manage SmartDNS split-DNS configuration.
# Runs BEFORE S38smartdns (S37 < S38) to ensure configs are ready.
#
# Actions:
#   start       — generate configs, activate current mode (split/default)
#   stop        — no-op (S38 manages daemon lifecycle)
#   restart     — regenerate configs, re-activate, restart S38
#   enable      — switch to split-DNS mode, regenerate, restart
#   disable     — switch to default mode (no split), regenerate, restart
#   flush-cache — stop S38, delete persistent DNS cache, start S38
#   status      — print current mode (enabled/disabled)
#
# shellcheck disable=SC1091
# shellcheck disable=SC3043
set -eu

BASE="/opt/keenetic-entware-extras/smartdns-geo-conf"
_CONFIG_DIR="$BASE/config"
. "$_CONFIG_DIR/defaults.conf"
[ -f "$_CONFIG_DIR/config.conf" ] && . "$_CONFIG_DIR/config.conf"
. /opt/keenetic-entware-extras/lib/common.sh

GENERATE="$BASE/scripts/generate-conf.sh"

# Regenerate bind-addrs.conf with current LAN IPs (IPv4 + IPv6).
# Called on every start/restart/enable/disable to keep bind addresses fresh.
do_bind_addrs() {
  local _router_ip _router_ip6
  _router_ip="$(detect_router_ip)"
  if [ -n "$_router_ip" ]; then
    cat > "$BIND_ADDRS_CONF" <<EOF
# Auto-generated by S37smartdns-conf.
# LAN IP bind address (router: $_router_ip).
bind ${_router_ip}:6053
bind-tcp ${_router_ip}:6053
EOF
  else
    cat > "$BIND_ADDRS_CONF" <<EOF
# Auto-generated by S37smartdns-conf.
# WARNING: could not detect router IP, using 0.0.0.0.
bind 0.0.0.0:6053
bind-tcp 0.0.0.0:6053
EOF
  fi
  _router_ip6="$(detect_router_ip6)"
  if [ -n "$_router_ip6" ]; then
    cat >> "$BIND_ADDRS_CONF" <<EOF

# IPv6 bind (auto-detected: LAN first, loopback last — mirrors IPv4 order)
bind [${_router_ip6}]:6053
bind-tcp [${_router_ip6}]:6053
bind [::1]:6053
bind-tcp [::1]:6053
EOF
  else
    cat >> "$BIND_ADDRS_CONF" <<EOF

# IPv6 loopback only (no global IPv6 detected)
bind [::1]:6053
bind-tcp [::1]:6053
EOF
  fi
}

# Generate dynamic configs from config.conf
do_generate() {
  if [ -x "$GENERATE" ]; then
    "$GENERATE"
  else
    echo "ERROR: generate-conf.sh not found or not executable" >&2
    return 1
  fi
}

# Activate split-DNS config as active smartdns.conf
do_activate() {
  if [ -f "$CONF_SPLIT" ]; then
    cp "$CONF_SPLIT" "$CONF"
  fi
}

# Restore S38 init script if it was renamed (disabled).
# Returns 0 if S38 is available after restore, 1 otherwise.
do_restore_s38() {
  if [ -f "${S38}.disabled" ] && [ ! -f "$S38" ]; then
    mv "${S38}.disabled" "$S38"
  fi
  [ -x "$S38" ]
}

# Rename S38 init script so it won't auto-start on boot.
do_disable_s38() {
  if [ -f "$S38" ]; then
    mv "$S38" "${S38}.disabled"
  fi
}

# Restart SmartDNS via S38 (background, non-blocking)
do_restart_s38() {
  if [ -x "$S38" ]; then
    ("$S38" restart >/dev/null 2>&1 &)
  fi
}

# Stop smartdns-redirect (S39) if present
do_stop_redirect() {
  local _s39="/opt/etc/init.d/S39smartdns-redirect"
  [ -x "$_s39" ] && "$_s39" stop 2>/dev/null || true
}

# Start smartdns-redirect (S39) if present (background, non-blocking)
do_start_redirect() {
  local _s39="/opt/etc/init.d/S39smartdns-redirect"
  [ -x "$_s39" ] && ("$_s39" start >/dev/null 2>&1 &) || true
}

case "${1:-}" in
  start)
    if [ -f "$STATE_FILE" ]; then
      # Enabled: restore S38 (may have been re-created by opkg upgrade),
      # generate configs, activate split-DNS config.
      do_restore_s38
      do_bind_addrs
      do_generate
      do_activate
    else
      # Disabled: ensure S38 won't start (rename before rc.unslung reaches S38)
      do_disable_s38
    fi
    ;;
  stop)
    # No-op: S38smartdns manages daemon stop
    ;;
  restart)
    do_bind_addrs
    do_generate
    do_activate
    do_restart_s38
    ;;
  enable)
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "enabled" > "$STATE_FILE"
    do_restore_s38
    do_bind_addrs
    do_generate
    do_activate
    do_restart_s38
    do_start_redirect
    echo "SmartDNS: split-DNS enabled (zone: $DNS_ZONE)"
    ;;
  disable)
    rm -f "$STATE_FILE"
    do_stop_redirect
    [ -x "$S38" ] && "$S38" stop 2>/dev/null || true
    do_disable_s38
    echo "SmartDNS: fully disabled (system DNS via ndnproxy)"
    ;;
  flush-cache)
    if [ -x "$S38" ]; then
      "$S38" stop 2>/dev/null || true
      rm -f "$CACHE_FILE"
      "$S38" start 2>/dev/null || true
      echo "SmartDNS: DNS cache flushed, daemon restarted"
    elif [ -f "${S38}.disabled" ]; then
      rm -f "$CACHE_FILE"
      echo "SmartDNS: DNS cache deleted (daemon disabled, not restarted)"
    else
      echo "ERROR: S38smartdns not found" >&2
      exit 1
    fi
    ;;
  status)
    if [ -f "$STATE_FILE" ]; then
      echo "enabled (zone: $DNS_ZONE)"
    else
      echo "disabled"
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|enable|disable|flush-cache|status}" >&2
    exit 1
    ;;
esac
