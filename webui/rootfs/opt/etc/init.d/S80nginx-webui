#!/opt/bin/sh
# nginx-webui init script for Entware.
# Standalone init (no rc.func) — safe alongside stock nginx.
# Config: /opt/keenetic-entware-extras/webui/config/nginx.conf (separate instance on port 8080).
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/webui"
_CONFIG_DIR="$INSTALL_DIR/config"
# shellcheck source=/dev/null
. "$_CONFIG_DIR/defaults.conf"
[ -f "$_CONFIG_DIR/config.conf" ] && . "$_CONFIG_DIR/config.conf"

DESC="nginx WebUI dashboard"
CONF="$_CONFIG_DIR/nginx.conf"
NGINX="/opt/sbin/nginx"
PATCH="$INSTALL_DIR/scripts/patch-stock-ui.sh"
PATH="/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin"

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    [ "$ENABLED" != "yes" ] && return 8
    printf " Starting %s... " "$DESC"
    if is_running; then
        echo "already running."
        return 0
    fi
    # Self-healing: generate listen.conf if missing (e.g. after spike deploy)
    if [ ! -f "$_CONFIG_DIR/listen.conf" ]; then
        # shellcheck source=/dev/null
        . /opt/keenetic-entware-extras/lib/common.sh
        _IP="$(detect_router_ip)"
        echo "listen ${_IP:-0.0.0.0}:8080;" > "$_CONFIG_DIR/listen.conf"
    fi
    # Patch stock UI into tmpfs
    "$PATCH"
    $NGINX -c "$CONF" 2>&1
    if is_running; then
        echo "done. PID=$(cat "$PIDFILE")"
    else
        echo "failed."
        return 1
    fi
}

stop() {
    printf " Stopping %s... " "$DESC"
    if is_running; then
        $NGINX -c "$CONF" -s stop 2>&1 || true
        COUNTER=0
        while is_running && [ "$COUNTER" -le 10 ]; do
            sleep 1
            COUNTER=$((COUNTER + 1))
        done
        if is_running; then
            echo "failed, killing PID."
            kill -9 "$(cat "$PIDFILE")" 2>/dev/null
            sleep 1
        else
            echo "done."
        fi
    else
        echo "not running (no PID)."
    fi
    # Kill any orphaned nginx processes holding our port.
    # Can't use cmdline match for workers (they lack $CONF in args and
    # "nginx: worker" pattern would hit stock Keenetic nginx workers).
    # Port-based detection is safe — only our instance uses 8080.
    _PORT_PIDS=$(netstat -tlnp 2>/dev/null | awk '/:8080 /{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\//) {split($i,a,"/"); print a[1]}}' | sort -u)
    if [ -n "$_PORT_PIDS" ]; then
        echo " Killing orphaned nginx-webui process(es) on port 8080..."
        echo "$_PORT_PIDS" | xargs kill -9 2>/dev/null || true
        sleep 1
    fi
    rm -f "$PIDFILE"
    # Clean up tmpfs
    rm -rf /tmp/ew-webui
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    check|status)
        if is_running; then
            echo "$DESC is running, PID=$(cat "$PIDFILE")"
        else
            echo "$DESC is not running."
            exit 1
        fi
        ;;
    reload)
        # Re-patch stock UI and reload nginx
        "$PATCH"
        $NGINX -c "$CONF" -s reload 2>&1
        echo "$DESC reloaded."
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|check|status|reload}"
        exit 1
        ;;
esac
