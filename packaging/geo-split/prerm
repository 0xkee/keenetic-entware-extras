#!/opt/bin/sh
# prerm — runs before package files are removed.
set -eu

# 1. Stop service
/opt/etc/init.d/S99geo-split stop 2>/dev/null || true

# 2. Remove NDM hook symlink
rm -f /opt/etc/ndm/ifstatechanged.d/geo-split-hook

# 3. Remove cron jobs
CRON_FILE="/opt/etc/crontab"
if [ -f "$CRON_FILE" ]; then
    sed -i '/geo-split/d' "$CRON_FILE"
fi

# 4. Cleanup runtime data
rm -f /opt/tmp/geo-routes.*.batch
rm -f /opt/tmp/geo-split-table-*.filled
rm -f /opt/tmp/geo-split.pid
rm -f /opt/tmp/geo-split-last-iface
# Legacy cleanup (old path)
rm -f /tmp/geo-routes.*.batch
rm -f /tmp/geo-split-table-*.filled
rm -f /tmp/geo-split.pid
