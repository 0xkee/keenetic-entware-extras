#!/opt/bin/sh
# postinst — runs after package files are unpacked.
# Must be idempotent (called on both install and upgrade).
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

BASE="/opt/keenetic-entware-extras/smartdns-conf-ru-split"
_CONFIG_DIR="$BASE/config"
. "$_CONFIG_DIR/defaults.conf"
[ -f "$_CONFIG_DIR/config.conf" ] && . "$_CONFIG_DIR/config.conf"
. /opt/keenetic-entware-extras/lib/common.sh

# 1. Auto-detect router LAN IP and generate bind-addrs.conf.
#    Separate file avoids conffile conflicts on upgrade.
#    Included by smartdns.conf via conf-file directive.
ROUTER_IP="$(detect_router_ip)"
if [ -n "$ROUTER_IP" ]; then
    cat > "$BIND_ADDRS_CONF" <<EOF
# Auto-generated by smartdns-conf-ru-split postinst.
# LAN IP bind address (router: $ROUTER_IP).
bind ${ROUTER_IP}:6053
bind-tcp ${ROUTER_IP}:6053
EOF
    echo "SmartDNS bind IP: 127.0.0.1 + $ROUTER_IP (UDP+TCP)"
else
    cat > "$BIND_ADDRS_CONF" <<EOF
# Auto-generated by smartdns-conf-ru-split postinst.
# WARNING: could not detect router IP, using 0.0.0.0.
bind 0.0.0.0:6053
bind-tcp 0.0.0.0:6053
EOF
    echo "WARNING: could not detect router IP, using 0.0.0.0 bind"
fi

# 2. Deploy both config variants (split-DNS and default)
if [ -f "$_CONFIG_DIR/smartdns.conf" ]; then
    cp "$_CONFIG_DIR/smartdns.conf" "$CONF_SPLIT"
fi
if [ -f "$_CONFIG_DIR/smartdns-default.conf" ]; then
    cp "$_CONFIG_DIR/smartdns-default.conf" "$CONF_DEFAULT"
fi

# 3. Activate config based on current state
if [ ! -f "$STATE_FILE" ]; then
    # First install — enable split-DNS by default
    cp "$CONF_SPLIT" "$CONF"
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "enabled" > "$STATE_FILE"
else
    # Upgrade — re-apply split-DNS config (state file exists = enabled)
    cp "$CONF_SPLIT" "$CONF"
fi

# 4. Restart SmartDNS with our config (|| true: S38 rc.func may report
#    spurious failure due to PID race; must not break set -eu)
if [ -x "$S38" ]; then
    "$S38" restart || true
fi

echo "smartdns-conf-ru-split installed. Config: $CONF"
echo "Toggle: $BASE/scripts/toggle.sh {enable|disable|status}"
echo "Status: $BASE/scripts/status.sh"
