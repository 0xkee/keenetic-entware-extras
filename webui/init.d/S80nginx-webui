#!/opt/bin/sh
# nginx-webui init script for Entware.
# Real script lives in package dir; symlink in /opt/etc/init.d/ enables boot.
# Standalone init (no rc.func) — safe alongside stock nginx.
# Config: /opt/keenetic-entware-extras/webui/config/nginx.conf (separate instance on port 8080).
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/webui"
_CONFIG_DIR="$INSTALL_DIR/config"
# shellcheck source=/dev/null
. /opt/keenetic-entware-extras/lib/common.sh
. "$_CONFIG_DIR/defaults.conf"
[ -f "$_CONFIG_DIR/config.conf" ] && . "$_CONFIG_DIR/config.conf"

DESC="nginx WebUI dashboard"
CONF="$_CONFIG_DIR/nginx.conf"
NGINX="/opt/sbin/nginx"
PATCH="$INSTALL_DIR/scripts/patch-stock-ui.sh"
PATH="/opt/sbin:/opt/bin:/sbin:/bin:/usr/sbin:/usr/bin"

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# Kill any process holding our port 8080 (orphaned nginx after force-reinstall, etc.)
# netstat shows only one worker PID per listen socket, but all N workers inherit
# the fd via fork — killing one lets the next sibling take over the socket.
# Fix: retry loop — each iteration kills the current holder until port is free.
kill_port_holders() {
    _retries=0
    while [ "$_retries" -lt 10 ]; do
        _PORT_PIDS=$(netstat -tlnp 2>/dev/null \
            | awk '/:8080 /{for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\//) {split($i,a,"/"); print a[1]}}' \
            | sort -u)
        [ -z "$_PORT_PIDS" ] && return 0
        [ "$_retries" -eq 0 ] && echo " Killing orphaned process(es) on port 8080..."
        echo "$_PORT_PIDS" | xargs kill -9 2>/dev/null || true
        sleep 1
        _retries=$((_retries + 1))
    done
}

start() {
    [ "$ENABLED" != "yes" ] && return 8
    printf " Starting %s... " "$DESC"
    if is_running; then
        echo "already running."
        return 0
    fi
    # Self-healing: generate listen.conf if missing or outdated format
    # (e.g. after spike deploy or upgrade from version without $stock_httpd)
    if [ ! -f "$_CONFIG_DIR/listen.conf" ] || ! grep -q 'stock_httpd' "$_CONFIG_DIR/listen.conf"; then
        _IP="$(detect_router_ip)"
        # shellcheck disable=SC2016  # $stock_httpd is an nginx variable, not shell
        printf 'listen %s:8080;\nset $stock_httpd http://%s:80;\n' \
            "${_IP:-0.0.0.0}" "${_IP:-127.0.0.1}" > "$_CONFIG_DIR/listen.conf"
    fi
    # Clear stale PID (Keenetic /tmp survives firmware updates)
    rm -f "$PIDFILE"
    # Ensure port 8080 is free (handles orphaned nginx after --force-reinstall)
    kill_port_holders
    # Patch stock UI into tmpfs
    "$PATCH"
    $NGINX -c "$CONF" 2>&1
    if is_running; then
        echo "done. PID=$(cat "$PIDFILE")"
    else
        echo "failed."
        return 1
    fi
}

stop() {
    printf " Stopping %s... " "$DESC"
    if is_running; then
        $NGINX -c "$CONF" -s stop 2>&1 || true
        COUNTER=0
        while is_running && [ "$COUNTER" -le 10 ]; do
            sleep 1
            COUNTER=$((COUNTER + 1))
        done
        if is_running; then
            echo "failed, killing PID."
            kill -9 "$(cat "$PIDFILE")" 2>/dev/null
            sleep 1
        else
            echo "done."
        fi
    else
        echo "not running (no PID)."
    fi
    # Kill any orphaned processes still holding port 8080
    kill_port_holders
    rm -f "$PIDFILE"
    # Clean up patched UI cache (tmpfs — large ephemeral data)
    rm -rf /tmp/ew-webui
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    check|status)
        if is_running; then
            echo "$DESC is running, PID=$(cat "$PIDFILE")"
        else
            echo "$DESC is not running."
            exit 1
        fi
        ;;
    reload)
        # Re-patch stock UI and reload nginx
        "$PATCH"
        $NGINX -c "$CONF" -s reload 2>&1
        echo "$DESC reloaded."
        ;;
    enable)
        ln -sf "$INSTALL_DIR/init.d/$(basename "$0")" "/opt/etc/init.d/$(basename "$0")"
        start
        ;;
    disable)
        stop
        rm -f "/opt/etc/init.d/$(basename "$0")"
        echo "nginx-webui disabled (persistent until 'enable')"
        ;;
    update-listen)
        # Force re-detect LAN IP → regenerate listen.conf → restart
        rm -f "$_CONFIG_DIR/listen.conf"
        stop; start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|check|status|reload|enable|disable|update-listen}"
        exit 1
        ;;
esac
