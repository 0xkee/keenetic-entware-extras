#!/opt/bin/sh
# geo-bypass init script for Entware.
# Installed to /opt/etc/init.d/S99geo-bypass by install.sh.
# INSTALL_DIR is patched by install.sh via sed to match actual install path.
# shellcheck disable=SC3043  # 'local' supported by ash/busybox sh
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/geo-bypass"
SCRIPTS="$INSTALL_DIR/scripts"
_CONFIG_DIR="$INSTALL_DIR/config"
# shellcheck source=/dev/null
. "$_CONFIG_DIR/config.sh"

# Background helper: refresh stale caches, re-activate if data changed
_refresh_if_stale() {
    local need=0
    if "$SCRIPTS/update-subnets.sh"; then need=1; fi
    if "$SCRIPTS/update-domains.sh"; then need=1; fi
    if [ "$need" -eq 1 ]; then
      "$SCRIPTS/apply-routes.sh"
    fi
}

case "${1:-}" in
  start)
    echo "Starting geo-bypass..."
    if [ ! -f "$SUBNET_LIST_FILE" ]; then
      # Cold start: no cache — download synchronously
      "$SCRIPTS/update-subnets.sh" --force || true
      "$SCRIPTS/update-domains.sh" || true
    fi
    # Single activation pass
    "$SCRIPTS/load-ipset.sh"
    "$SCRIPTS/attach-rules.sh"
    # Background: refresh stale caches + re-activate if changed
    _refresh_if_stale &
    ;;
  stop)
    echo "Stopping geo-bypass..."
    "$SCRIPTS/detach-rules.sh"
    ipset destroy "$IPSET_NAME" 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    "$SCRIPTS/status.sh"
    ;;
  update)
    echo "Updating geo-bypass (subnets + domains)..."
    "$SCRIPTS/update-subnets.sh" --force || true
    "$SCRIPTS/update-domains.sh" --force || true
    "$SCRIPTS/apply-routes.sh"
    echo "Update complete."
    ;;
  update-subnets)
    echo "Updating subnets..."
    if "$SCRIPTS/update-subnets.sh" --force; then
      "$SCRIPTS/apply-routes.sh"
    fi
    echo "Subnet update complete."
    ;;
  update-domains)
    echo "Updating domains..."
    if "$SCRIPTS/update-domains.sh" --force; then
      "$SCRIPTS/attach-rules.sh"
    fi
    echo "Domain update complete."
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|update|update-subnets|update-domains}"
    exit 1
    ;;
esac
