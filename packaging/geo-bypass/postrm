#!/opt/bin/sh
# postrm — runs after package files are removed.
# Cleans up empty directories that opkg leaves behind.
set -eu

# Remove empty directories left by opkg
for d in scripts loaders config docs; do
  rmdir "/opt/keenetic-entware-extras/geo-bypass/$d" 2>/dev/null || true
done
rmdir "/opt/keenetic-entware-extras/geo-bypass" 2>/dev/null || true
