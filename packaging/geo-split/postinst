#!/opt/bin/sh
# postinst — runs after package files are unpacked.
# Must be idempotent (called on both install and upgrade).
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/geo-split"

# 1. Create NDM hook symlink
NDM_DIR="/opt/etc/ndm/ifstatechanged.d"
mkdir -p "$NDM_DIR"
ln -sf "$INSTALL_DIR/scripts/ndm-hook.sh" "$NDM_DIR/geo-split-hook"

# 2. Update cron jobs (remove old, add new — safe on upgrade)
CRON_FILE="/opt/etc/crontab"
if [ -f "$CRON_FILE" ]; then
    sed -i '/geo-split/d' "$CRON_FILE"
fi
# Randomize cron offset (0-14) to avoid thundering herd on ipdeny.com
OFFSET=$(awk 'BEGIN{srand(); printf "%d", rand()*15}')
{
    echo "# geo-split: periodic refresh (checks cache freshness, reloads if stale)"
    echo "${OFFSET}-59/15 * * * * root /opt/etc/init.d/S99geo-split refresh"
} >> "$CRON_FILE"

# 3. Restart crond to pick up changes
if [ -x /opt/etc/init.d/S10cron ]; then
    /opt/etc/init.d/S10cron restart 2>/dev/null || true
fi

echo "geo-split installed. User config: $INSTALL_DIR/config/config.conf"
echo "Start: /opt/etc/init.d/S99geo-split start"

# 4. Auto-start service (idempotent: safe for both fresh install and upgrade).
# On upgrade: prerm stopped the service → restart with new code.
# On fresh install: defaults (ROUTE_OUT=auto, ROUTE_IN=br0) are reasonable.
echo "Starting geo-split..."
if /opt/etc/init.d/S99geo-split start; then
    echo "geo-split started. User config: $INSTALL_DIR/config/config.conf"
else
    echo "Warning: geo-split start failed. Check user config: $INSTALL_DIR/config/config.conf"
    echo "Manual start: /opt/etc/init.d/S99geo-split start"
fi
