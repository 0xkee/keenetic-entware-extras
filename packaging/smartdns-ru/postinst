#!/opt/bin/sh
# postinst — runs after package files are unpacked.
# Must be idempotent (called on both install and upgrade).
set -eu

S38="/opt/etc/init.d/S38smartdns"

# Restart SmartDNS with our config (|| true: S38 rc.func may report
# spurious failure due to PID race; must not break set -eu)
if [ -x "$S38" ]; then
    "$S38" restart || true
fi

echo "smartdns-ru installed. Config: /opt/etc/smartdns/smartdns.conf"
echo "Status: /opt/keenetic-entware-extras/smartdns-ru/scripts/status.sh"
