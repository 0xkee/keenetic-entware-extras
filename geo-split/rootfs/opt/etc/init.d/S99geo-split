#!/opt/bin/sh
# geo-split init script for Entware.
# Installed to /opt/etc/init.d/S99geo-split by install.sh.
# INSTALL_DIR is patched by install.sh via sed to match actual install path.
# shellcheck disable=SC3043  # 'local' supported by ash/busybox sh
# shellcheck disable=SC1091  # sourced files resolved at runtime on router
set -eu

INSTALL_DIR="/opt/keenetic-entware-extras/geo-split"
SCRIPTS="$INSTALL_DIR/scripts"
_CONFIG_DIR="$INSTALL_DIR/config"
# shellcheck source=/dev/null
. "$_CONFIG_DIR/config.sh"

case "${1:-}" in
  start)
    echo "Starting geo-split..."
    # Parallel: subnets and domains use separate temp files, batch files and tables
    # (no conflicts after table separation refactor)
    "$SCRIPTS/update-subnets.sh" &
    "$SCRIPTS/update-domains.sh" &
    wait
    # Connect LAN to tables
    "$SCRIPTS/attach-rules.sh"
    # Write PID file (mtime used for uptime tracking)
    echo $$ > "$PIDFILE"
    ;;
  stop)
    echo "Stopping geo-split..."
    "$SCRIPTS/detach-rules.sh"
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    "$SCRIPTS/status.sh"
    ;;
  refresh)
    # Cron: loaders check freshness + fill tables if stale. No ip rules.
    "$SCRIPTS/update-subnets.sh" &
    "$SCRIPTS/update-domains.sh" &
    wait
    ;;
  update)
    echo "Updating geo-split (subnets + domains)..."
    "$SCRIPTS/update-subnets.sh" --force &
    "$SCRIPTS/update-domains.sh" --force &
    wait
    echo "Update complete."
    ;;
  update-subnets)
    echo "Updating subnets..."
    "$SCRIPTS/update-subnets.sh" --force
    echo "Subnet update complete."
    ;;
  update-domains)
    echo "Updating domains..."
    "$SCRIPTS/update-domains.sh" --force
    echo "Domain update complete."
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|refresh|update|update-subnets|update-domains}"
    exit 1
    ;;
esac
